debug = true

params.publish_dir_mode = 'symlink'
params.publish_dir_mode_fastpreads = 'symlink'
params.gtdbversion = '214'
// use small kraken db while developing
params.gtdb_path = '/home/db/kraken2/gtdb_r214/256gb/'
params.long_read_assemblies = ''
params.tree_samples_list = ''
params.bakta_db = '/home/cccon/BaktaDB/Full/db'
params.snippy_ref = 'assets/GCF_000026565.1_ASM2656v1_genomic.gbff'
params.snippy_mask = 'assets/PHASTEST_AKU12601_PhageRegions.bed'


apptainer.enabled = true
apptainer.envWhitelist = 'JAVA_TOOL_OPTIONS'
wave {
    enabled = true
    strategy = ['conda']
    containerEngine = 'apptainer'
    freeze = true
}

process {
	withLabel: process_1 {
		cpus = 1
	}
		withLabel: process_4 {
		cpus = 4
	}
	withLabel: process_8 {
		cpus = 8
	}
}
executor {
	cpus = 64
	memory = '250 GB'
}

env {
    	JAVA_TOOL_OPTIONS = '-XX:+PerfDisableSharedMem'
}
